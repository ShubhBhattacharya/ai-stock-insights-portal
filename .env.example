# AI Stock Insights Portal — Example Environment Configuration
# Copy this file to .env for local overrides (never commit real secrets to Git).

# Optional persistent database connection string.
# Defaults to local SQLite (data/portal.db) if unset.
# Example for PostgreSQL: postgresql://user:password@localhost:5432/stock_portal
DATABASE_URL=

# Optional OpenAI API Key for AI Stock Tutor natural language responses.
# If unset, the portal uses its built-in rule-based financial reasoning engine.
OPENAI_API_KEY=

# Optional secret key for session salt / token signing
PORTAL_SECRET_KEY=dev-secret-key-change-in-production
